# Keep this file private after copying it to .env. Never put these values in GitHub Secrets, the APK, or chat.
NANU_CONTROL_TOKEN=replace-with-a-random-32-plus-character-control-token
NANU_MODE=paper
NANU_AUTOSTART=false
NANU_AUTO_LIVE_ENABLED=false
NANU_PAIRS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
NANU_TRADE_QUOTE_USDT=5
NANU_MAX_TRADES_PER_DAY=4
NANU_STOP_LOSS_PCT=1
NANU_TAKE_PROFIT_PCT=1.5
NANU_DAILY_LOSS_PCT=2
NANU_MIN_CONFIDENCE=68
NANU_SCAN_SECONDS=60

# Required only for NANU_MODE=test or NANU_MODE=live. Create a restricted Binance Spot API key:
# enable Spot trading only, disable withdrawals, restrict by this VPS public IP, and do not share it.
BINANCE_API_KEY=
BINANCE_API_SECRET=
