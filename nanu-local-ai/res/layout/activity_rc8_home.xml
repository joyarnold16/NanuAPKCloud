<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nanu_home_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nanu_glass"
            app:cardCornerRadius="28dp"
            app:strokeColor="@color/nanu_border_bright"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <com.example.llama.NanuPulseView
                    android:layout_width="96dp"
                    android:layout_height="96dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.18"
                        android:text="NANU"
                        android:textColor="@color/nanu_accent_2"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Private intelligence.\nLive when you ask."
                        android:textColor="@color/nanu_text"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Local AI, document memory and safe read-only internet tools."
                        android:textColor="@color/nanu_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nanu_panel_2"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nanu_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/home_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="1.0 final test • private local AI"
                android:textColor="@color/nanu_success"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/home_agent_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.08"
            android:text="TRY NANU AGENT"
            android:textColor="@color/nanu_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_quick_weather"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="Kanpur weather"
                android:textAllCaps="false"
                android:textColor="@color/nanu_text"
                app:cornerRadius="18dp"
                app:strokeColor="@color/nanu_success" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_quick_btc"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="BTC price now"
                android:textAllCaps="false"
                android:textColor="@color/nanu_text"
                app:cornerRadius="18dp"
                app:strokeColor="@color/nanu_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_quick_news"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="Latest AI news"
                android:textAllCaps="false"
                android:textColor="@color/nanu_text"
                app:cornerRadius="18dp"
                app:strokeColor="@color/nanu_file" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_quick_tarot"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="3-card Tarot"
                android:textAllCaps="false"
                android:textColor="@color/nanu_text"
                app:cornerRadius="18dp"
                app:strokeColor="@color/nanu_accent_2" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_workspace_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AI"
            android:textColor="@color/nanu_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_chat"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="💬   Chat + Models\n       Local chat, coding, study, attachments"
            android:textAllCaps="false"
            android:textColor="@color/nanu_text"
            app:strokeColor="@color/nanu_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_online_tools"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="🌐   Online Tools: ON\n       Weather, prices, news, web &amp; image search"
            android:textAllCaps="false"
            android:textColor="@color/nanu_text"
            app:strokeColor="@color/nanu_success" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_talk"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="🎙   Continuous Talk\n       Speak → Nanu replies → listens again"
            android:textAllCaps="false"
            android:textColor="@color/nanu_text"
            app:strokeColor="@color/nanu_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_files"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="▤   Ask My Files\n       PDF, Word, Excel, PPTX, CSV, text"
            android:textAllCaps="false"
            android:textColor="@color/nanu_text"
            app:strokeColor="@color/nanu_file" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_create"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="▣   Create Studio\n       Local images, aspect ratios, history"
            android:textAllCaps="false"
            android:textColor="@color/nanu_text"
            app:strokeColor="@color/nanu_image" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_tarot"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="✦   Nanu Tarot\n       78 cards, meanings, 1-card &amp; 3-card readings"
            android:textAllCaps="false"
            android:textColor="@color/nanu_text"
            app:strokeColor="@color/nanu_accent_2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="TRUST &amp; PRIVACY"
            android:textColor="@color/nanu_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_safety"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="✓   Privacy, Safety &amp; Reports\n       Data practices, AI report form, terms"
            android:textAllCaps="false"
            android:textColor="@color/nanu_text"
            app:strokeColor="@color/nanu_success" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_pro"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:text="Nanu Pro · Files, photos, assistants &amp; projects"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="Online tools are used only when you ask for current information and may be turned off. Documents, project memory and local AI responses stay on your device unless you share them."
            android:textColor="@color/nanu_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
