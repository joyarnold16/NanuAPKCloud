<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nanu_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/talk8_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Back" android:textAllCaps="false" android:textColor="@color/nanu_accent_2" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Continuous Talk" android:textColor="@color/nanu_text" android:textSize="23sp" android:textStyle="bold" />
            <Space android:layout_width="64dp" android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Tap Speak to start • tap the same button again to stop immediately" android:textColor="@color/nanu_muted" android:textSize="12sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/nanu_panel_2" app:cardCornerRadius="16dp" app:strokeColor="@color/nanu_border" app:strokeWidth="1dp">
            <TextView android:id="@+id/talk8_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:text="Starting local AI and voice…" android:textColor="@color/nanu_success" android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/talk8_button" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="16dp" android:enabled="false" android:text="Speak" android:textAllCaps="false" android:textColor="@color/nanu_accent_2" android:textSize="18sp" app:backgroundTint="@color/nanu_panel_2" app:strokeColor="@color/nanu_accent" app:strokeWidth="1dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/talk8_continuous" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Continuous: On" android:textAllCaps="false" android:textColor="@color/nanu_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/talk8_voice" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Voice reply: On" android:textAllCaps="false" android:textColor="@color/nanu_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/talk8_stop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="82dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="Stop" android:textAllCaps="false" android:textColor="@color/nanu_danger" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/nanu_panel" app:cardCornerRadius="18dp" app:strokeColor="@color/nanu_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You" android:textColor="@color/nanu_muted" android:textStyle="bold" /><TextView android:id="@+id/talk8_heard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="60dp" android:text="Your speech will appear here." android:textColor="@color/nanu_text" android:textSize="17sp" /></LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/nanu_assistant" app:cardCornerRadius="18dp" app:strokeColor="@color/nanu_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nanu" android:textColor="@color/nanu_accent_2" android:textStyle="bold" /><TextView android:id="@+id/talk8_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="180dp" android:text="Tap Speak and speak naturally." android:textColor="@color/nanu_text" android:textIsSelectable="true" android:textSize="17sp" /></LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="18dp" android:gravity="center" android:text="On-device speech is preferred when available. Android may use the installed speech service if offline recognition is unavailable. AI generation remains local." android:textColor="@color/nanu_muted" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
