<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:gravity="end"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/nanu_user"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/nanu_user_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView android:id="@+id/msg_timestamp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/nanu_muted" />

    <TextView
                android:id="@+id/msg_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="680dp"
                android:textColor="@android:color/white"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/msg_attachment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@color/nanu_input"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textColor="@color/nanu_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/msg_copy"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="Copy"
        android:textColor="@color/nanu_muted"
        android:textSize="10sp" />
</LinearLayout>
