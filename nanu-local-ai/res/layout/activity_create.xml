<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nanu_bg"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/create_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/nanu_accent_2" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Nanu Create"
                android:textColor="@color/nanu_text"
                android:textSize="23sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="72dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Local text-to-image • images save to Gallery"
            android:textColor="@color/nanu_muted"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/nanu_panel"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/nanu_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Image model"
                    android:textColor="@color/nanu_accent_2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/image_model_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/nanu_text"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/image_model_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Download image model"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/nanu_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Describe your image"
            android:textColor="@color/nanu_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/image_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/nanu_input"
            android:gravity="top|start"
            android:hint="A small red boat on a calm lake at sunrise…"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minHeight="100dp"
            android:padding="14dp"
            android:textColor="@color/nanu_text"
            android:textColorHint="@color/nanu_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Avoid (optional)"
            android:textColor="@color/nanu_text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/image_negative_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/nanu_input"
            android:hint="blurry, distorted, low quality"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="68dp"
            android:padding="14dp"
            android:textColor="@color/nanu_text"
            android:textColorHint="@color/nanu_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Generation mode"
            android:textColor="@color/nanu_text"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/image_quality_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="Mode: Fast • 384 × 384 • 8 steps"
            android:textAllCaps="false"
            android:textColor="@color/nanu_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Fast is recommended on phones/tablets. Tap the mode button for higher-quality 512×512 generation."
            android:textColor="@color/nanu_muted"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/generate_image_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="Generate fast image"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/nanu_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_image_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Cancel generation"
            android:textAllCaps="false"
            android:textColor="@color/nanu_danger" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/nanu_panel_2"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nanu_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/image_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="Ready"
                android:textColor="@color/nanu_text"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/generated_image"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="Generated image"
            android:scaleType="fitCenter"
            android:visibility="invisible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="While generating, Nanu keeps the screen awake and shows elapsed time. Successful images are copied to Pictures/Nanu in your Gallery."
            android:textColor="@color/nanu_muted"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
