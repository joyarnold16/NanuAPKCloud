<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nanu_bg"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/file_chat_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Back" android:textAllCaps="false" android:textColor="@color/nanu_accent_2" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Ask My Files" android:textColor="@color/nanu_text" android:textSize="23sp" android:textStyle="bold" />
            <Space android:layout_width="64dp" android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Private document Q&amp;A • processed locally" android:textColor="@color/nanu_muted" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/file_chat_pick" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Choose PDF / Word / Excel / PPTX / CSV" android:textAllCaps="false" android:textColor="@android:color/white" app:backgroundTint="@color/nanu_accent" />
        <TextView android:id="@+id/file_chat_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="No document selected" android:textColor="@color/nanu_text" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/file_chat_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Starting local AI…" android:textColor="@color/nanu_muted" android:textSize="12sp" />
        <EditText android:id="@+id/file_chat_question" android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="18dp" android:background="@color/nanu_input" android:gravity="top|start" android:hint="Ask something about this document…" android:inputType="textCapSentences|textMultiLine" android:padding="14dp" android:textColor="@color/nanu_text" android:textColorHint="@color/nanu_muted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/file_chat_ask" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:enabled="false" android:text="Ask Nanu locally" android:textAllCaps="false" android:textColor="@android:color/white" app:backgroundTint="@color/nanu_accent" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/file_chat_history" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Recent questions" android:textAllCaps="false" android:textColor="@color/nanu_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/file_chat_report" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Report output" android:textAllCaps="false" android:textColor="@color/nanu_danger" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/nanu_panel_2" app:cardCornerRadius="18dp" app:strokeColor="@color/nanu_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nanu answer" android:textColor="@color/nanu_accent_2" android:textStyle="bold" />
                <TextView android:id="@+id/file_chat_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="220dp" android:text="Choose a document and ask a question." android:textColor="@color/nanu_text" android:textIsSelectable="true" android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="18dp" android:gravity="center" android:text="Nanu can extract text from common office documents. Scanned/image-only documents may need OCR in a future release." android:textColor="@color/nanu_muted" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
