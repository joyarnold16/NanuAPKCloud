<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nanu_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/trading_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="‹ Chat"
                android:textAllCaps="false"
                android:textColor="@color/nanu_accent_2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NANU Trading Lab"
                    android:textColor="@color/nanu_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forex + Crypto • deterministic technical analysis"
                    android:textColor="@color/nanu_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/nanu_panel"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/nanu_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/market_type_button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Crypto"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@color/nanu_accent" />

                    <EditText
                        android:id="@+id/trading_symbol"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="BTC/USD"
                        android:padding="10dp"
                        android:singleLine="true"
                        android:textColor="@color/nanu_text"
                        android:textColorHint="@color/nanu_muted" />

                    <EditText
                        android:id="@+id/trading_timeframe"
                        android:layout_width="82dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:hint="15m"
                        android:padding="10dp"
                        android:singleLine="true"
                        android:text="15m"
                        android:textColor="@color/nanu_text"
                        android:textColorHint="@color/nanu_muted" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Paste OHLCV candles"
                    android:textColor="@color/nanu_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Format: time,open,high,low,close,volume — one candle per line. Time and volume are optional."
                    android:textColor="@color/nanu_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/candle_input"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/nanu_input"
                    android:gravity="top|start"
                    android:hint="2026-08-22 10:00,65000,65200,64800,65120,1250\n2026-08-22 10:15,65120,65310,65050,65280,1410"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:padding="12dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/nanu_text"
                    android:textColorHint="@color/nanu_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/analyze_chart_button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Analyze chart"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@color/nanu_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/live_snapshot_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Live snapshot"
                        android:textAllCaps="false"
                        android:textColor="@color/nanu_text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scan_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Scanner"
                        android:textAllCaps="false"
                        android:textColor="@color/nanu_accent_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/risk_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Risk calculator"
                        android:textAllCaps="false"
                        android:textColor="@color/nanu_accent_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/patterns_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Patterns"
                        android:textAllCaps="false"
                        android:textColor="@color/nanu_accent_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/journal_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Trade journal"
                        android:textAllCaps="false"
                        android:textColor="@color/nanu_accent_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chart_image_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Chart image"
                        android:textAllCaps="false"
                        android:textColor="@color/nanu_accent_2" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="@color/nanu_panel_2"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/nanu_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nanu analysis"
                    android:textColor="@color/nanu_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/trading_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="180dp"
                    android:text="Paste candles and tap Analyze chart. Calculations happen locally on your device."
                    android:textColor="@color/nanu_text"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Educational analysis only. Markets are probabilistic; Nanu does not guarantee profits or place trades in this release."
                    android:textColor="@color/nanu_danger"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
