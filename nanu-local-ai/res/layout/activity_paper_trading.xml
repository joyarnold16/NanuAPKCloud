<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nanu_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/paper_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Back" android:textAllCaps="false" android:textColor="@color/nanu_accent_2" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Paper Trading" android:textColor="@color/nanu_text" android:textSize="23sp" android:textStyle="bold" />
            <Space android:layout_width="64dp" android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Virtual money only • no broker, wallet or exchange connection" android:textColor="@color/nanu_success" android:textSize="12sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/nanu_panel_2" app:cardCornerRadius="18dp" app:strokeColor="@color/nanu_border" app:strokeWidth="1dp">
            <TextView android:id="@+id/paper_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/nanu_text" android:textSize="15sp" android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Open virtual position" android:textColor="@color/nanu_text" android:textStyle="bold" />
        <EditText android:id="@+id/paper_symbol" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@color/nanu_input" android:hint="Symbol, e.g. BTC/USD or EURUSD" android:paddingHorizontal="14dp" android:singleLine="true" android:textColor="@color/nanu_text" android:textColorHint="@color/nanu_muted" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <EditText android:id="@+id/paper_price" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@color/nanu_input" android:hint="Entry price" android:inputType="numberDecimal" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/nanu_text" android:textColorHint="@color/nanu_muted" />
            <EditText android:id="@+id/paper_qty" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@color/nanu_input" android:hint="Quantity" android:inputType="numberDecimal" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/nanu_text" android:textColorHint="@color/nanu_muted" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/paper_side" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Side: LONG" android:textAllCaps="false" android:textColor="@color/nanu_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/paper_open" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Open virtual" android:textAllCaps="false" android:textColor="@android:color/white" app:backgroundTint="@color/nanu_accent" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/nanu_panel" app:cardCornerRadius="18dp" app:strokeColor="@color/nanu_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open positions" android:textColor="@color/nanu_trading" android:textStyle="bold" /><TextView android:id="@+id/paper_positions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="160dp" android:textColor="@color/nanu_text" android:textIsSelectable="true" android:textSize="14sp" /></LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/paper_close" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Close a virtual position" android:textAllCaps="false" android:textColor="@android:color/white" app:backgroundTint="@color/nanu_accent" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/paper_history" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Closed history" android:textAllCaps="false" android:textColor="@color/nanu_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/paper_reset" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Reset account" android:textAllCaps="false" android:textColor="@color/nanu_danger" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="18dp" android:gravity="center" android:text="Paper Trading is a local simulation for practice. It does not connect to a broker, exchange, wallet, API key or real funds and does not predict future performance." android:textColor="@color/nanu_muted" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
