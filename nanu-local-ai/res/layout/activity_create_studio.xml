<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nanu_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/studio_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Back" android:textAllCaps="false" android:textColor="@color/nanu_accent_2" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Nanu Create Studio" android:textColor="@color/nanu_text" android:textSize="23sp" android:textStyle="bold" />
            <Space android:layout_width="64dp" android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Local text-to-image • no cloud generation" android:textColor="@color/nanu_muted" android:textSize="12sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@color/nanu_panel" app:cardCornerRadius="18dp" app:strokeColor="@color/nanu_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Image model" android:textColor="@color/nanu_accent_2" android:textStyle="bold" />
                <TextView android:id="@+id/studio_model_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/nanu_text" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/studio_model_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="Download / inspect image model" android:textAllCaps="false" android:textColor="@android:color/white" app:backgroundTint="@color/nanu_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Describe your image" android:textColor="@color/nanu_text" android:textStyle="bold" />
        <EditText android:id="@+id/studio_prompt" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="6dp" android:background="@color/nanu_input" android:gravity="top|start" android:hint="A cinematic lighthouse in a storm at night…" android:inputType="textCapSentences|textMultiLine" android:padding="14dp" android:textColor="@color/nanu_text" android:textColorHint="@color/nanu_muted" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Avoid" android:textColor="@color/nanu_text" android:textStyle="bold" />
        <EditText android:id="@+id/studio_negative" android:layout_width="match_parent" android:layout_height="74dp" android:layout_marginTop="6dp" android:background="@color/nanu_input" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine" android:padding="12dp" android:textColor="@color/nanu_text" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/studio_quality" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Quality: Fast" android:textAllCaps="false" android:textColor="@color/nanu_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/studio_aspect" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Aspect: 1:1" android:textAllCaps="false" android:textColor="@color/nanu_text" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/studio_generate" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:enabled="false" android:text="Generate" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="15sp" app:backgroundTint="@color/nanu_accent" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/studio_history" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Image history" android:textAllCaps="false" android:textColor="@color/nanu_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/studio_report" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Report issue" android:textAllCaps="false" android:textColor="@color/nanu_danger" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/studio_cancel" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="42dp" android:text="Cancel generation" android:textAllCaps="false" android:textColor="@color/nanu_danger" />
        <TextView android:id="@+id/studio_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@color/nanu_panel_2" android:gravity="center" android:minHeight="58dp" android:padding="12dp" android:text="Ready" android:textColor="@color/nanu_text" android:textSize="12sp" />
        <ImageView android:id="@+id/studio_image" android:layout_width="match_parent" android:layout_height="380dp" android:layout_marginTop="14dp" android:adjustViewBounds="true" android:contentDescription="Generated image" android:scaleType="fitCenter" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="18dp" android:gravity="center" android:text="Completed images are saved to Pictures/Nanu when Android allows it. Wider/taller modes may take longer than square Fast mode." android:textColor="@color/nanu_muted" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
