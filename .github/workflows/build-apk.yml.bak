name: Build Nanu AI Trading Bot APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: write
  packages: read

jobs:
  build-apk:
    name: Build signed release APK
    runs-on: ubuntu-latest
    env:
      NANU_RELEASE_KEYSTORE_PATH: ${{ github.workspace }}/nanu-release.keystore
      NANU_RELEASE_KEYSTORE_PASSWORD: ${{ secrets.NANU_RELEASE_KEYSTORE_PASSWORD }}
      NANU_RELEASE_KEY_ALIAS: ${{ secrets.NANU_RELEASE_KEY_ALIAS }}
      NANU_RELEASE_KEY_PASSWORD: ${{ secrets.NANU_RELEASE_KEY_PASSWORD }}
      GITHUB_TOKEN: ${{ github.token }}
      RELEASE_TAG: nanu-ai-trading-bot-v8-0-dex-safety-paper
      APK_NAME: nanu-ai-trading-bot-v8-0-dex-safety-paper.apk

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Accept Android licenses
        run: yes | sdkmanager --licenses || true

      - name: Install Android SDK packages
        run: sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.10.2'

      - name: Decode release keystore
        env:
          NANU_RELEASE_KEYSTORE_B64: ${{ secrets.NANU_RELEASE_KEYSTORE_B64 }}
        run: |
          test -n "$NANU_RELEASE_KEYSTORE_B64" || (echo "Missing NANU_RELEASE_KEYSTORE_B64 secret" && exit 1)
          test -n "$NANU_RELEASE_KEYSTORE_PASSWORD" || (echo "Missing NANU_RELEASE_KEYSTORE_PASSWORD secret" && exit 1)
          test -n "$NANU_RELEASE_KEY_ALIAS" || (echo "Missing NANU_RELEASE_KEY_ALIAS secret" && exit 1)
          test -n "$NANU_RELEASE_KEY_PASSWORD" || (echo "Missing NANU_RELEASE_KEY_PASSWORD secret" && exit 1)
          printf '%s' "$NANU_RELEASE_KEYSTORE_B64" | base64 -d > "$NANU_RELEASE_KEYSTORE_PATH"

      - name: Test, lint, and build signed release APK
        run: gradle --no-daemon clean testReleaseUnitTest lintRelease assembleRelease --stacktrace

      - name: Prepare APK and release notes
        run: |
          cp app/build/outputs/apk/release/app-release.apk "$APK_NAME"
          cat > release-notes.md <<'NOTES'
          Nanu AI Trading Bot v8.0 DEX Safety Paper

          - DEX-only launch screen; Binance and Telegram controls are not exposed by the active application path
          - Locally encrypted Trust Wallet Core bot-wallet identity with separate BNB Chain and Solana public addresses
          - DEX Screener discovery, deterministic liquidity/volume/age/activity filters, and clear BLOCKED/WATCHING/QUALIFIED decisions
          - Hard risk controls for per-trade amount, daily trade count, daily loss reference, liquidity floor, pair age, stop, and target
          - Foreground local scanner, custom app UI, paper-position monitor, event history, pause, and panic state
          - Mainnet DEX signing is intentionally blocked in this build pending device-level BNB Chain and Solana route tests

          No risk score can prove a token safe, guarantee a successful DEX exit, or guarantee profit. Do not fund a wallet until its recovery phrase is backed up offline.
          NOTES
          ls -lh "$APK_NAME"

      - name: Publish release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if gh release view "$RELEASE_TAG" >/dev/null 2>&1; then
            gh release upload "$RELEASE_TAG" "$APK_NAME" --clobber
          else
            gh release create "$RELEASE_TAG" "$APK_NAME" \
              --title "Nanu AI Trading Bot v8.0 DEX Safety Paper" \
              --notes-file release-notes.md \
              --latest
          fi
